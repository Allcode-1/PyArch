{% if database == "postgres" -%}
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/app
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@tests_db:5432/app_test

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

TEST_POSTGRES_DB=
TEST_POSTGRES_USER=
TEST_POSTGRES_PASSWORD=

{% else -%}
DATABASE_URL=sqlite:///./app.db
TEST_DATABASE_URL=sqlite:///./app_test.db
{% endif %}
