from sqlalchemy import select
from sqlalchemy.orm import Session

from app.models.{{ module_name }} import {{ model_name }}


def _apply_pagination(statement, limit: int | None, offset: int):
    if offset:
        statement = statement.offset(offset)
    if limit is not None:
        statement = statement.limit(limit)
    return statement


class {{ model_name }}Repository:
    def __init__(self, db: Session):
        self.db = db

    def create(
        self,
        title: str,
        description: str | None,
    ) -> {{ model_name }}:
        {{ module_name }} = {{ model_name }}(title=title, description=description)

        self.db.add({{ module_name }})
        return {{ module_name }}

    def get_by_id(self, {{ module_name }}_id: int) -> {{ model_name }} | None:
        return self.db.scalar(
            select({{ model_name }}).where({{ model_name }}.id == {{ module_name }}_id)
        )

    def list(
        self,
        limit: int | None = None,
        offset: int = 0,
    ) -> list[{{ model_name }}]:
        statement = select({{ model_name }}).order_by({{ model_name }}.id)

        return list(
            self.db.scalars(_apply_pagination(statement, limit, offset)).all()
        )

    def update(
        self,
        {{ module_name }}: {{ model_name }},
        values: dict[str, object],
    ) -> {{ model_name }}:

        for field, value in values.items():
            setattr({{ module_name }}, field, value)

        return {{ module_name }}

    def delete(self, {{ module_name }}: {{ model_name }}) -> None:
        self.db.delete({{ module_name }})
